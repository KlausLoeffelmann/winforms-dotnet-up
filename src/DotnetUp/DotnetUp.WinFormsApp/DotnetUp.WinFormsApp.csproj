<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.22000.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <WarpToolkitVersion>[0.*-preview*,)</WarpToolkitVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WarpToolkit.WinForms.AppServices" Version="$(WarpToolkitVersion)" />
    <PackageReference Include="WarpToolkit.WinForms.Specialized" Version="$(WarpToolkitVersion)" />
    <PackageReference Include="WarpToolkit.WinForms.DirectX" Version="$(WarpToolkitVersion)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DotnetUp.SmokeTests" />
  </ItemGroup>

</Project>
